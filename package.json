{
  "name": "paseo-plugin-account-switcher",
  "version": "0.6.0",
  "type": "module",
  "license": "MIT",
  "author": "dutchakdev",
  "engines": {
    "node": ">=22.12.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "keywords": [
    "paseo",
    "paseo-plugin",
    "plugin",
    "claude",
    "claude-code",
    "codex",
    "chatgpt",
    "accounts",
    "multi-account",
    "quotas",
    "usage-limits"
  ],
  "description": "Use several Claude and ChatGPT/Codex subscription accounts in Paseo: choose one per agent, switch a chat to another account, and see every account's limits",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config tests/vitest.config.ts",
    "build": "node scripts/build.mjs",
    "check": "npm run build && npm run typecheck && npm test",
    "prepack": "npm run build && node scripts/pack-manifest.mjs strip && node scripts/shrinkwrap.mjs write",
    "postpack": "node scripts/pack-manifest.mjs restore && node scripts/shrinkwrap.mjs remove"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5"
  },
  "devDependencies": {
    "@getpaseo/client": "0.8.0",
    "@getpaseo/plugin": "0.8.0",
    "@getpaseo/protocol": "0.8.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "esbuild": "^0.25.12",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "semver": "^7.8.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dutchakdev/paseo-plugin-account-switcher.git"
  },
  "homepage": "https://github.com/dutchakdev/paseo-plugin-account-switcher#readme",
  "bugs": {
    "url": "https://github.com/dutchakdev/paseo-plugin-account-switcher/issues"
  },
  "files": [
    "paseo-plugin.json",
    "npm-shrinkwrap.json",
    "assets/icon.png",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "licenses/",
    "THIRD_PARTY_NOTICES.md"
  ]
}
